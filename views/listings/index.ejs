<% layout("/layouts/boilerplate") %>

    <h3>All Listings</h3>
    <form action="/listings" method="GET" class="search-panel mb-4">
        <!-- Search -->
        <div class="d-flex gap-2 mb-3">
            <input type="text" name="search" value="<%= search %>" class="form-control"
                placeholder="Search by city or title...">
            <button class="btn btn-dark" type="submit">
                Search
            </button>
        </div>
        <!-- Price Filter -->
        <div class="d-flex flex-wrap gap-2">
            <input type="number" name="minPrice" class="form-control" value="<%= minPrice || '' %>"
                style="width: 140px;" min="0" placeholder="Min Price ₹">
            <input type="number" name="maxPrice" class="form-control" value="<%= maxPrice || '' %>"
                style="width: 140px;" min="0" placeholder="Max Price ₹">
            <button class="btn btn-outline-dark" type="submit">
                <i class="fa-solid fa-filter"></i> Filter
            </button>
            <a href="/listings" class="btn btn-outline-secondary">
                Clear
            </a>
        </div>

    </form>


    <% if (allListings.length===0) { %>
        <p class="text-muted">No listings found.</p>
        <% } %>
            <div class="row row-cols-lg-3 row-cols-md-2  row-cols-sm-1">
                <% for(let listing of allListings) { %>
                    <a href="/listings/<%= listing._id %>" class="listing-link">
                        <div class="card listing-card">
                            <img src="<%=listing.image.url%>" class="card-img-top" alt="listing_image"
                                style="height:20rem">
                            <div class="card-img-overlay"></div>
                            <div class="card-body ">
                                <p class="card-text">
                                    <b>
                                        <%= listing.title %>
                                    </b> <br>
                                    <small class="text-muted">
                                        <%= listing.location %>, <%= listing.country %>
                                    </small>
                                    <br>
                                    &#8377;<%= listing.price.toLocaleString("en-IN") %>
                                        <span class="text-muted fw-normal">/ night</span>
                                </p>
                            </div>
                        </div>
                    </a>
                    <% }%>
            </div>
            <% if (totalPages> 1) { %>
                <nav aria-label="Listing pages">
                    <ul class="pagination justify-content-center mt-4">
                        <!-- Previous -->
                        <li class="page-item <%= page === 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="/listings?<%= queryString %>&page=<%= page - 1 %>">
                                Previous
                            </a>
                        </li>
                        <!-- Page numbers -->
                        <% for (let i=1; i <=totalPages; i++) { %>
                            <li class="page-item <%= i === page ? 'active' : '' %>">
                                <a class="page-link" href="/listings?<%= queryString %>&page=<%= i %>">
                                    <%= i %>
                                </a>
                            </li>
                            <% } %>
                                <!-- Next -->
                                <li class="page-item <%= page === totalPages ? 'disabled' : '' %>">
                                    <a class="page-link" href="/listings?<%= queryString %>&page=<%= page + 1 %>">
                                        Next
                                    </a>
                                </li>
                    </ul>
                </nav>
                <% } %>